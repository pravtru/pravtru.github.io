<Bl Name="Помещение на плане цепей управления">

<!-- Помещение — прямоугольник: стены толщиной 2 мм (200 мм в М 1:100) двумя линиями 0,2 мм,
     название помещения 2,5 мм у верхней стены по центру (id="11").
     Размеры — из параметров генератора (длина и ширина помещения): наружный контур id 1 (width, height),
     внутренний контур id 2 (width − 4, height − 4), название id 11 (атрибут x — середина ширины).
     Начало (0,0) — левый верхний угол наружного контура. Кабели прокладываются вдоль внутренней стороны стен; оборудование ставится у стены, отодвинутым от неё на ширину кабеля, лицевой (утолщённой) стороной в помещение. -->
<svg viewBox="-1 -1 66 46" xmlns="http://www.w3.org/2000/svg">
 <Bl0 Name="Font"></Bl0>
 <g>
  <rect id="1" x="0" y="0" width="64" height="44" fill="none" stroke="#000000" stroke-width="0.2"/>
  <rect id="2" x="2" y="2" width="60" height="40" fill="none" stroke="#000000" stroke-width="0.2"/>
  <text id="11" font-size="3.65" x="32" y="8" text-anchor="middle" class="text">Помещение</text>
 </g>
</svg>

</Bl>
