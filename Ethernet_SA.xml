<Bl Name="Ethernet подвал СА">
<var id="length" name="Длина линии, мм" type="n" default="56.5" min="1" />
<!-- Опорная точка (0,0) — начало линии под цифрой, зазор 1 мм.
     Параметр length задаёт длину прямого отрезка; центр кружка length+1.
     Вставка: <Bl Name="Ethernet_SA"><Pr bid="length">40</Pr></Bl>.
     Радиус кружка постоянный, масштабирование не требуется. -->
<svg viewBox="-8 -6 16 {length+14.5}" xmlns="http://www.w3.org/2000/svg">
 <Bl0 Name="Font"></Bl0>
 <g transform="translate(0 0) rotate(0 0 0)">
  <circle id="4" cx="0" cy="{length+1}" r="1" fill="none" stroke="#000000" stroke-width="0.2"/>
  <line id="3" x1="0" y1="0" x2="0" y2="{length}" stroke="#000000" stroke-width="0.2"/>
  <text id="1" font-size="3.65" x="0" y="-1" text-anchor="middle" class="text" font-family="gost">0</text>
  <text id="2" font-size="3.65" x="-2" y="10" text-anchor="middle" class="text" font-family="gost" transform="rotate(-90 -2 10)"></text>
 </g>
</svg>
</Bl>
