<El Name="Электродвигатель асинхронный трёхфазный">

 <TYPE>электродвигатель</TYPE>
 <UNIT>шт</UNIT>
 <PIN>U</PIN> <PIN>V</PIN> <PIN>W</PIN> <PIN>PE</PIN>

<!-- Схема принципиальная: две окружности, фазы сверху с шагом 10 мм, PE слева; позиция — id="1".
     Выводы: U (-10,0), V (0,0), W (10,0), PE (-15,16). -->
<svg tip="SP" viewBox="-20 -6 40 32" xmlns="http://www.w3.org/2000/svg">
 <Bl0 Name="Font"></Bl0>
 <g>
 <text font-size="5.11" x="-12" y="8" text-anchor="end" class="text" id="1">{POS}</text>
 <circle cx="0" cy="16" r="9.5" fill="none" stroke="#000000" stroke-width="0.3"/>
 <circle cx="0" cy="16" r="4.8" fill="none" stroke="#000000" stroke-width="0.2"/>
 <polyline points="-10,0 -10,5 -5.5,8.3" fill="none" stroke="#000000" stroke-width="0.2"/>
 <line x1="0" y1="0" x2="0" y2="6.5" stroke="#000000" stroke-width="0.2"/>
 <polyline points="10,0 10,5 5.5,8.3" fill="none" stroke="#000000" stroke-width="0.2"/>
 <polyline points="-15,16 -9.5,16" fill="none" stroke="#000000" stroke-width="0.2"/>
 <circle cx="-9.5" cy="16" r="0.5" fill="#000000"/>
 <text font-size="3.65" x="-8.5" y="-1" class="text">U</text>
 <text font-size="3.65" x="1.5" y="-1" class="text">V</text>
 <text font-size="3.65" x="11.5" y="-1" class="text">W</text>
 <text font-size="3.65" x="-15" y="14.5" class="text">PE</text>
 </g>
 <circle cx="-10" cy="0" r="0" PIN="U"/><circle cx="0" cy="0" r="0" PIN="V"/><circle cx="10" cy="0" r="0" PIN="W"/><circle cx="-15" cy="16" r="0" PIN="PE"/>
</svg>

<!-- Схема внешних соединений, по образцу вентиляции Промпроекта (Соя, «П3...5,В1,У, откл. вент, внешн.»):
     окружности R10 и R5 с буквой M, позиция слева (id="1"); под двигателем клеммы 5 × 5 мм PE, U, V, W;
     от клемм вниз жилы 12 мм, номера цепей вертикально слева от жил (id 11–14).
     Выводы жил: PE (2.5,37), U (7.5,37), V (12.5,37), W (17.5,37). -->
<svg tip="SV" viewBox="-14 -2 36 41" xmlns="http://www.w3.org/2000/svg">
 <Bl0 Name="Font"></Bl0>
 <g>
  <text id="1" font-size="5.11" x="-1.5" y="5" text-anchor="end" class="text">{POS}</text>
  <circle cx="10" cy="10" r="10" fill="none" stroke="#000000" stroke-width="0.3"/>
  <circle cx="10" cy="10" r="5" fill="none" stroke="#000000" stroke-width="0.2"/>
  <text font-size="5.11" x="10" y="11.5" text-anchor="middle" class="text">M</text>
  <polyline points="0,20 20,20 20,25 0,25 0,20" fill="none" stroke="#000000" stroke-width="0.2"/>
  <line x1="5" y1="20" x2="5" y2="25" stroke="#000000" stroke-width="0.2"/>
  <line x1="10" y1="20" x2="10" y2="25" stroke="#000000" stroke-width="0.2"/>
  <line x1="15" y1="20" x2="15" y2="25" stroke="#000000" stroke-width="0.2"/>
  <text font-size="3.65" x="2.5" y="23.5" text-anchor="middle" class="text">PE</text>
  <text font-size="3.65" x="7.5" y="23.5" text-anchor="middle" class="text">U</text>
  <text font-size="3.65" x="12.5" y="23.5" text-anchor="middle" class="text">V</text>
  <text font-size="3.65" x="17.5" y="23.5" text-anchor="middle" class="text">W</text>
  <line x1="2.5" y1="25" x2="2.5" y2="37" stroke="#000000" stroke-width="0.2"/>
  <line x1="7.5" y1="25" x2="7.5" y2="37" stroke="#000000" stroke-width="0.2"/>
  <line x1="12.5" y1="25" x2="12.5" y2="37" stroke="#000000" stroke-width="0.2"/>
  <line x1="17.5" y1="25" x2="17.5" y2="37" stroke="#000000" stroke-width="0.2"/>
  <text id="11" font-size="3.65" x="1.9" y="34" class="text" transform="rotate(-90 1.9 34)">PE</text>
  <text id="12" font-size="3.65" x="6.9" y="34" class="text" transform="rotate(-90 6.9 34)">C1</text>
  <text id="13" font-size="3.65" x="11.9" y="34" class="text" transform="rotate(-90 11.9 34)">C2</text>
  <text id="14" font-size="3.65" x="16.9" y="34" class="text" transform="rotate(-90 16.9 34)">C3</text>
 </g>
 <circle cx="2.5" cy="37" r="0" PIN="PE"/><circle cx="7.5" cy="37" r="0" PIN="U"/><circle cx="12.5" cy="37" r="0" PIN="V"/><circle cx="17.5" cy="37" r="0" PIN="W"/>
</svg>

</El>
