<El Name="Пост кнопочный на две кнопки (Meyertec)">

 <TYPE>электроаппарат</TYPE>
 <UNIT>шт</UNIT>
 <PIN>13</PIN> <PIN>14</PIN> <PIN>21</PIN> <PIN>22</PIN>

<!-- Схема автоматизации, по образцу кнопок на схеме автоматизации насосной станции Промпроекта
     (БалтТехПром, «Насосная станция противопожарного и технического водоснабжения 409», СА.dwg):
     прибор по месту — окружность R5 без черты; сверху буквенный код HS (ручное управление, ГОСТ 21.208) 2,5 мм,
     снизу позиция 2,5 мм (id="1"). Линии связи подходят сверху (0,-5) и снизу (0,5). -->
<svg tip="SA" viewBox="-7 -7 14 14" xmlns="http://www.w3.org/2000/svg">
 <Bl0 Name="Font"></Bl0>
 <g>
  <circle cx="0" cy="0" r="5" fill="#FFFFFF" stroke="#000000" stroke-width="0.2"/>
  <text font-size="3.65" x="0" y="-1.25" text-anchor="middle" class="text">HS</text>
  <text id="1" font-size="3.65" x="0" y="3.15" text-anchor="middle" class="text">{POS}</text>
 </g>
 <circle cx="0" cy="-5" r="0" PIN="SA1"/><circle cx="0" cy="5" r="0" PIN="SA2"/>
</svg>

<!-- План цепей управления, по образцу поста S1 на плане цепей управления насосной станции Промпроекта
     (БалтТехПром, «Насосная станция противопожарного и технического водоснабжения 409», План.dwg, М 1:100):
     квадрат 2,5 × 2,5 мм с кружком кнопки R0,3 в центре; кабель (линия 0,6 мм) подходит к середине нижней стороны (вывод PL (0,1.25)).
     Начало (0,0) — центр поста; позиция и номер кабеля — на выноске (блок PL_Vynoska). -->
<svg tip="PL" viewBox="-3 -3 6 7" xmlns="http://www.w3.org/2000/svg">
 <g>
  <rect x="-1.25" y="-1.25" width="2.5" height="2.5" fill="none" stroke="#000000" stroke-width="0.2"/>
  <circle cx="0" cy="0" r="0.3" fill="none" stroke="#000000" stroke-width="0.2"/>
 </g>
 <circle cx="0" cy="1.25" r="0" PIN="PL"/>
</svg>

<!-- Схема внешних соединений, по образцу поста П3-S на схеме вентиляции Промпроекта
     (Соя, «П3...5,В1,У, откл. вент, внешн.», лист с постом управления приточной системой):
     корпус 22 × 28 мм пунктиром, кнопки друг под другом — блок SB1 (замыкающая 13-14) сверху, SB2 (размыкающая 21-22) снизу,
     номера выводов у кружков; жилы выходят из корпуса в стороны (13, 21 влево, 14, 22 вправо) и идут вниз (жилы рисуются под кнопками, кружки клемм их перекрывают),
     номера цепей вертикально слева от жил (id 11–14, подстановки {LNK_вывод}). Позиция над корпусом (id="1"), позиции кнопок id 2, 3 скрыты, как в образце.
     Выводы жил: 13 (-6,40), 21 (-2,40), 22 (24,40), 14 (28,40). -->
<svg tip="SV" viewBox="-12 -8 44 50" xmlns="http://www.w3.org/2000/svg">
 <Bl0 Name="Font"></Bl0>
 <g>
  <text id="1" font-size="5.11" x="11" y="-2" text-anchor="middle" class="text">{POS}</text>
  <polyline points="0,0 22,0 22,28 0,28 0,0" fill="none" stroke="#000000" stroke-width="0.3" stroke-dasharray="2 1"/>
  <polyline points="3.5,11 -6,11 -6,40" fill="none" stroke="#000000" stroke-width="0.2"/>
  <polyline points="3.5,21.5 -2,21.5 -2,40" fill="none" stroke="#000000" stroke-width="0.2"/>
  <polyline points="18.5,21.5 24,21.5 24,40" fill="none" stroke="#000000" stroke-width="0.2"/>
  <polyline points="18.5,11 28,11 28,40" fill="none" stroke="#000000" stroke-width="0.2"/>
  <g transform="translate(3.5 11)"><Bl Name="SB1"><Pr bid="2" id="2" display="none">SB1</Pr><Pr bid="3">13</Pr><Pr bid="4">14</Pr></Bl></g>
  <g transform="translate(3.5 21.5)"><Bl Name="SB2"><Pr bid="2" id="3" display="none">SB2</Pr><Pr bid="3">21</Pr><Pr bid="4">22</Pr></Bl></g>
  <text id="11" font-size="3.65" x="-6.6" y="38" class="text" transform="rotate(-90 -6.6 38)">{LNK_13}</text>
  <text id="12" font-size="3.65" x="-2.6" y="38" class="text" transform="rotate(-90 -2.6 38)">{LNK_21}</text>
  <text id="13" font-size="3.65" x="23.4" y="38" class="text" transform="rotate(-90 23.4 38)">{LNK_22}</text>
  <text id="14" font-size="3.65" x="27.4" y="38" class="text" transform="rotate(-90 27.4 38)">{LNK_14}</text>
 </g>
 <circle cx="-6" cy="40" r="0" PIN="13"/><circle cx="-2" cy="40" r="0" PIN="21"/><circle cx="24" cy="40" r="0" PIN="22"/><circle cx="28" cy="40" r="0" PIN="14"/>
</svg>

</El>
