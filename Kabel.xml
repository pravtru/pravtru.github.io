<El Name="Кабель">

 <TYPE>кабель</TYPE>
 <UNIT>м</UNIT>
 <PIN>1</PIN> <PIN>2</PIN>

<!-- Схема внешних соединений, по образцу кабеля П3-4 на схеме вентиляции Промпроекта
     (Соя, «П3...5,В1,У, откл. вент, внешн.»): вертикальная линия кабеля 0,4 мм, кружок R5 с номером кабеля 2,5 мм (id="1"),
     марка 3,5 мм над полкой выноски длиной 31 мм с изломом 3 × 3 мм (id="2"), длина вертикально 2,5 мм слева от линии (id="3").
     Оборудование сверху, щит снизу: марка — между оборудованием и кружком, длина — между кружком и щитом.
     Концы линии: 1 — к оборудованию (0,-20), 2 — к щиту (0,20). -->
<svg tip="SV" viewBox="-36 -22 42 44" xmlns="http://www.w3.org/2000/svg">
 <Bl0 Name="Font"></Bl0>
 <g>
  <line x1="0" y1="-20" x2="0" y2="20" stroke="#000000" stroke-width="0.4"/>
  <circle cx="0" cy="0" r="5" fill="#FFFFFF" stroke="#000000" stroke-width="0.2"/>
  <text id="1" font-size="3.65" x="0" y="1.25" text-anchor="middle" class="text">W1</text>
  <polyline points="0,-11 -3,-14 -34,-14" fill="none" stroke="#000000" stroke-width="0.2"/>
  <text id="2" font-size="5.11" x="-34" y="-15" class="text">КВВГнг-LS 4х1,5</text>
  <text id="3" font-size="3.65" x="-0.6" y="16" class="text" transform="rotate(-90 -0.6 16)">10 м</text>
 </g>
 <circle cx="0" cy="-20" r="0" PIN="1"/><circle cx="0" cy="20" r="0" PIN="2"/>
</svg>

</El>
