<El Name="Кабель">

 <TYPE>кабель</TYPE>
 <UNIT>м</UNIT>
 <PIN>1</PIN> <PIN>2</PIN>

<!-- План цепей управления: трасса кабеля — ломаная линия 0,6 мм с поворотами под прямым углом, вплотную вдоль стен,
     от вывода PL щита к выводу PL изделия (ответвление к изделию тоже 0,6 мм); параллельные кабели идут одной линией;
     номер кабеля — в ячейке выноски изделия (блок PL_Vynoska).
     Здесь показан отрезок трассы с концами 1 (0,0) и 2 (20,10). -->
<svg tip="PL" viewBox="-2 -2 24 14" xmlns="http://www.w3.org/2000/svg">
 <g>
  <polyline points="0,0 0,10 20,10" fill="none" stroke="#000000" stroke-width="0.6"/>
 </g>
 <circle cx="0" cy="0" r="0" PIN="1"/><circle cx="20" cy="10" r="0" PIN="2"/>
</svg>

<!-- Схема внешних соединений, по образцу кабеля П3-4 на схеме вентиляции Промпроекта
     (Соя, «П3...5,В1,У, откл. вент, внешн.»): вертикальная линия кабеля 0,4 мм, кружок R5 линией 0,4 мм с номером кабеля — цифрой, 3,5 мм (id="1"),
     марка 3,5 мм над полкой выноски длиной 31 мм с изломом 3 × 3 мм (id="2"), длина вертикально 2,5 мм слева от линии (id="3").
     Оборудование сверху, щит снизу: марка — между оборудованием и кружком, длина — между кружком и щитом.
     Концы линии: 1 — к оборудованию (0,-20), 2 — к щиту (0,20). -->
<svg tip="SV" viewBox="-36 -22 42 44" xmlns="http://www.w3.org/2000/svg">
 <Bl0 Name="Font"></Bl0>
 <g>
  <line x1="0" y1="-20" x2="0" y2="20" stroke="#000000" stroke-width="0.4"/>
  <circle cx="0" cy="0" r="5" fill="#FFFFFF" stroke="#000000" stroke-width="0.4"/>
  <text id="1" font-size="5.11" x="0" y="1.75" text-anchor="middle" class="text">{POS}</text>
  <polyline points="0,-11 -3,-14 -34,-14" fill="none" stroke="#000000" stroke-width="0.2"/>
  <text id="2" font-size="5.11" x="-34" y="-15" class="text">{MARK}</text>
  <text id="3" font-size="3.65" x="-0.6" y="16" class="text" transform="rotate(-90 -0.6 16)">{QTY} {UNIT}</text>
 </g>
 <circle cx="0" cy="-20" r="0" PIN="1"/><circle cx="0" cy="20" r="0" PIN="2"/>
</svg>

</El>
