<El Name="Ввод питания ~380 В (PE, L1, L2, L3, N)">

 <PIN>PE</PIN> <PIN>L1</PIN> <PIN>L2</PIN> <PIN>L3</PIN> <PIN>N</PIN>

<!-- Схема принципиальная, по образцу Промпроекта («Задвижки SV1…SV3. Схема электрическая принципиальная», Пример.pdf;
     27-17-АТХ): две части (атрибут PART).
     Фазы: подписи над линиями с шагом 10 мм, PE — самая левая линия; название ввода — id="1".
     Выводы: PE (-10,19), L1 (0,19), L2 (10,19), L3 (20,19). -->
<svg tip="SP" PART="фазы" viewBox="-16 -4 42 26" xmlns="http://www.w3.org/2000/svg">
 <Bl0 Name="Font"></Bl0>
 <g>
 <text id="1" font-size="5.11" x="5" y="0" text-anchor="middle" class="text">{SNAME}</text>
 <text font-size="5.11" x="-10" y="8" text-anchor="middle" class="text">PE</text>
 <text font-size="5.11" x="0" y="8" text-anchor="middle" class="text">L1</text>
 <text font-size="5.11" x="10" y="8" text-anchor="middle" class="text">L2</text>
 <text font-size="5.11" x="20" y="8" text-anchor="middle" class="text">L3</text>
 <polyline points="-10,10 -10,19" fill="none" stroke="#000000" stroke-width="0.2"/>
 <polyline points="0,10 0,19" fill="none" stroke="#000000" stroke-width="0.2"/>
 <polyline points="10,10 10,19" fill="none" stroke="#000000" stroke-width="0.2"/>
 <polyline points="20,10 20,19" fill="none" stroke="#000000" stroke-width="0.2"/>
 </g>
 <circle cx="-10" cy="19" r="0" PIN="PE"/><circle cx="0" cy="19" r="0" PIN="L1"/><circle cx="10" cy="19" r="0" PIN="L2"/><circle cx="20" cy="19" r="0" PIN="L3"/>
</svg>

<!-- Нейтраль: шина N справа от цепи управления — подпись N над вертикальной линией; вывод N внизу (0,19). -->
<svg tip="SP" PART="нейтраль" viewBox="-4 -4 8 26" xmlns="http://www.w3.org/2000/svg">
 <Bl0 Name="Font"></Bl0>
 <g>
 <text font-size="5.11" x="0" y="8" text-anchor="middle" class="text">N</text>
 <polyline points="0,10 0,19" fill="none" stroke="#000000" stroke-width="0.2"/>
 </g>
 <circle cx="0" cy="19" r="0" PIN="N"/>
</svg>

</El>
