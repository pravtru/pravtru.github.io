<El Name="Пускатель (контактор) DILM…-10">

 <TYPE>электроаппарат</TYPE>
 <UNIT>шт</UNIT>
 <PIN>1</PIN> <PIN>2</PIN> <PIN>3</PIN> <PIN>4</PIN> <PIN>5</PIN> <PIN>6</PIN> <PIN>A1</PIN> <PIN>A2</PIN> <PIN>13</PIN> <PIN>14</PIN>

<!-- Схема автоматизации, по образцу пускателей на схеме автоматизации насосной станции Промпроекта
     (БалтТехПром, «Насосная станция противопожарного и технического водоснабжения 409», СА.dwg):
     прибор на щите — окружность R5 с горизонтальной чертой через центр; сверху буквенный код NS
     (пускатель, ГОСТ 21.208) 2,5 мм, снизу позиция 2,5 мм (id="1"). Линии связи подходят сверху (0,-5) и снизу (0,5). -->
<svg tip="SA" viewBox="-7 -7 14 14" xmlns="http://www.w3.org/2000/svg">
 <Bl0 Name="Font"></Bl0>
 <g>
  <circle cx="0" cy="0" r="5" fill="#FFFFFF" stroke="#000000" stroke-width="0.2"/>
  <line x1="-5" y1="0" x2="5" y2="0" stroke="#000000" stroke-width="0.2"/>
  <text font-size="3.65" x="0" y="-1.25" text-anchor="middle" class="text">NS</text>
  <text id="1" font-size="3.65" x="0" y="3.65" text-anchor="middle" class="text">{POS}</text>
 </g>
 <circle cx="0" cy="-5" r="0" PIN="SA1"/><circle cx="0" cy="5" r="0" PIN="SA2"/>
</svg>

<!-- Схема принципиальная, разнесённый способ (ГОСТ 2.702): три части с позицией KM1, атрибут PART.
     Главные контакты — блок KM1 без катушки и блок-контактов; выводы 1, 3, 5 сверху (y = -15), 2, 4, 6 снизу (y = 0), полюса x = 0, 10, 20. -->
<svg tip="SP" PART="контакты главные" viewBox="-15 -24 40 30" xmlns="http://www.w3.org/2000/svg">
 <Bl0 Name="Font"></Bl0>
 <Bl Name="KM1"><Pr bid="pz">{POS}</Pr><Pr bid="2" display="none"></Pr><Pr bid="3" display="none"></Pr><Pr bid="4" display="none"></Pr></Bl>
 <circle cx="0" cy="-15" r="0" PIN="1"/><circle cx="0" cy="0" r="0" PIN="2"/>
 <circle cx="10" cy="-15" r="0" PIN="3"/><circle cx="10" cy="0" r="0" PIN="4"/>
 <circle cx="20" cy="-15" r="0" PIN="5"/><circle cx="20" cy="0" r="0" PIN="6"/>
</svg>

<!-- Катушка — блок KT: выводы A1 (0,0), A2 (15,0). -->
<svg tip="SP" PART="катушка" viewBox="-4 -12 23 18" xmlns="http://www.w3.org/2000/svg">
 <Bl0 Name="Font"></Bl0>
 <Bl Name="KT"><Pr bid="2">{POS}</Pr><Pr bid="3">A1</Pr><Pr bid="4">A2</Pr></Bl>
 <circle cx="0" cy="0" r="0" PIN="A1"/><circle cx="15" cy="0" r="0" PIN="A2"/>
</svg>

<!-- Блок-контакт замыкающий — блок NO: выводы 13 (0,0), 14 (15,0). -->
<svg tip="SP" PART="контакт вспомогательный" viewBox="-4 -10 23 16" xmlns="http://www.w3.org/2000/svg">
 <Bl0 Name="Font"></Bl0>
 <Bl Name="NO"><Pr bid="2">{POS}</Pr><Pr bid="3">13</Pr><Pr bid="4">14</Pr></Bl>
 <circle cx="0" cy="0" r="0" PIN="13"/><circle cx="15" cy="0" r="0" PIN="14"/>
</svg>

</El>
