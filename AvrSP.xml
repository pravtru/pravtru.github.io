<Bl Name="АВР двух насосов на ПР200">
 <var id="phase" default="L"/>
 <var id="neutral" default="N"/>
 <var id="common" default="501"/>
 <var id="pressure" default="502"/>
 <var id="feedback1" default="503"/>
 <var id="feedback2" default="504"/>
 <var id="start1a" default="7"/>
 <var id="start1b" default="8"/>
 <var id="start2a" default="15"/>
 <var id="start2b" default="16"/>
 <var id="rsb" default="RS-485 B"/>
 <var id="rsa" default="RS-485 A"/>
 <svg viewBox="0 0 210 297" xmlns="http://www.w3.org/2000/svg">
  <g transform="translate(20 172)" data-corner-spec="true">
   <path d="M 0 0 H 185 V 55 H 0 Z M 25 0 V 55 M 135 0 V 55 M 150 0 V 55
            M 0 15 H 185 M 0 23 H 185 M 0 31 H 185 M 0 39 H 185 M 0 47 H 185"
         fill="none" stroke="#000000" stroke-width="0.2"/>
   <g>
    <text x="12.5" y="6.75" font-size="5.11" class="text" text-anchor="middle">Позиция,</text>
    <text x="12.5" y="11.75" font-size="5.11" class="text" text-anchor="middle">обозначение</text>
    <text x="80" y="9.25" font-size="5.11" class="text" text-anchor="middle">Наименование</text>
    <text x="142.5" y="9.25" font-size="5.11" class="text" text-anchor="middle">Кол-во</text>
    <text x="167.5" y="9.25" font-size="5.11" class="text" text-anchor="middle">Примечание</text>
    <ObjView Name="cabinet" field="true" x="80" y="20.5" font-size="3.65" class="text" text-anchor="middle">На щите {POS}</ObjView>
    <ObjView Name="plc-breaker" field="true" x="12.5" y="28.5" font-size="3.65" class="text" text-anchor="middle">{POS}</ObjView>
    <ObjView Name="plc-breaker" field="true" x="27" y="28.5" font-size="3.65" class="text">{SNAME}, {MARK}</ObjView>
    <ObjView Name="plc-breaker" field="true" x="142.5" y="28.5" font-size="3.65" class="text" text-anchor="middle">{QTY}</ObjView>
    <ObjView Name="plc" field="true" x="12.5" y="36.5" font-size="3.65" class="text" text-anchor="middle">{POS}</ObjView>
    <ObjView Name="plc" field="true" x="27" y="36.5" text-anchor="start" font-size="3.65" class="text">{SNAME}, {MARK}</ObjView>
    <ObjView Name="plc" field="true" x="142.5" y="36.5" font-size="3.65" class="text" text-anchor="middle">{QTY}</ObjView>
    <text x="80" y="44.5" font-size="3.65" class="text" text-anchor="middle">По месту</text>
    <ObjView Name="pds" field="true" x="12.5" y="52.5" font-size="3.65" class="text" text-anchor="middle">{POS}</ObjView>
    <ObjView Name="pds" field="true" x="27" y="52.5" text-anchor="start" font-size="3.65" class="text">{SNAME}, {MARK}</ObjView>
    <ObjView Name="pds" field="true" x="142.5" y="52.5" font-size="3.65" class="text" text-anchor="middle">{QTY}</ObjView>
   </g>
   <path d="M 72 21.1 H 88 M 74 45.1 H 86" fill="none" stroke="#000000" stroke-width="0.2"/>
  </g>
  <g transform="translate(-1.5 -60)">
  <ObjView Name="plc" tip="SP" transform="translate(108 100)">
   <Pr bid="MARK">{MARK}</Pr>
   <Pr bid="pins">1 2 4 5 6 15 18 33</Pr>
   <Pr bid="device_layout">compact</Pr>
   <Pr bid="DI1" gap="5"/>
   <Pr bid="DI2" gap="18"/>
   <Pr bid="DI3" gap="13"/>
   <Pr bid="DO3" gap="5"/>
   <Pr bid="RS1B" gap="2"/>
  </ObjView>

  <!-- Питание ПР200 и цепей дискретных входов от сети ~230 В. -->
  <ChainPath ref="phase" index="1"/>
  <ChainPath ref="neutral" index="1"/>
  <ChainPath ref="common" index="1"/>
  <g transform="translate(72.8 105)"><ObjView Name="plc-breaker" tip="SPC"/></g>
  <text x="72.8" y="78" font-size="5.11" class="text" text-anchor="middle">{phase}</text>
  <text x="103" y="78" font-size="5.11" class="text" text-anchor="middle">{neutral}</text>
  <circle cx="72.8" cy="112" r="0.5"/><circle cx="103" cy="107" r="0.5"/>

  <!-- Контакты KM1 и KM2 физически находятся в цепях листа 5. -->
  <ChainPath ref="common" index="2"/>
  <ChainPath ref="pressure" index="1"/>
  <ChainPath ref="feedback1" index="1"/>
  <ChainPath ref="feedback2" index="1"/>
  <circle cx="72.8" cy="130" r="0.5"/><circle cx="72.8" cy="153" r="0.5"/>
  <g transform="translate(79 130)"><ObjView Name="pds" tip="SP"/></g>
  <g transform="translate(79 153)"><ObjView Name="KM1" tip="SP" part="контакт вспомогательный"/></g>
  <g transform="translate(79 171)"><ObjView Name="KM2" tip="SP" part="контакт вспомогательный"/></g>
  <path d="M 75.6 142.6 H 97.5 V 159.9 H 75.6 Z M 75.6 160.6 H 97.5 V 177.9 H 75.6 Z"
        fill="none" stroke="#000000" stroke-width="0.2" stroke-dasharray="2 1"/>
  <path d="M 75.6 157 L 71 159 H 59 M 75.6 175 L 71 177 H 59"
        fill="none" stroke="#000000" stroke-width="0.2"/>
  <text x="63.15" y="158" font-size="3.65" class="text" text-anchor="middle">см. л. 5</text>
  <text x="63.15" y="176" font-size="3.65" class="text" text-anchor="middle">см. л. 5</text>
  <g font-size="3.65" text-anchor="middle">
   <text x="101" y="128" class="text" font-size="3.65" text-anchor="middle">{pressure}</text>
   <text x="77.8" y="110" class="text" font-size="3.65" text-anchor="middle">{common}</text>
   <text x="101" y="151" class="text" font-size="3.65" text-anchor="middle">{feedback1}</text>
   <text x="101" y="169" class="text" font-size="3.65" text-anchor="middle">{feedback2}</text>
  </g>

  <path d="M 26.5 75 H 50 V 180 H 26.5 Z M 26.5 123.5 H 50 M 26.5 144 H 50 M 26.5 162 H 50"
        fill="none" stroke="#000000" stroke-width="0.2"/>
  <text x="38.25" y="101.75" font-size="3.65" class="text" text-anchor="middle">Питание ~230 В</text>
  <text x="38.25" y="129" font-size="3.65" class="text" text-anchor="middle">Перепад давления</text>
  <ObjView Name="pds" field="true" x="38.25" y="135" font-size="3.65" class="text" text-anchor="middle">{MARK}</ObjView>
  <ObjView Name="pump1" field="true" x="38.25" y="151" font-size="3.65" class="text" text-anchor="middle">Работа насоса {POS}</ObjView>
  <ObjView Name="KM1" field="true" x="38.25" y="157" font-size="3.65" class="text" text-anchor="middle">{POS} включён</ObjView>
  <ObjView Name="pump2" field="true" x="38.25" y="169" font-size="3.65" class="text" text-anchor="middle">Работа насоса {POS}</ObjView>
  <ObjView Name="KM2" field="true" x="38.25" y="175" font-size="3.65" class="text" text-anchor="middle">{POS} включён</ObjView>

  <!-- Выходные цепи и интерфейс. -->
  <ChainPath ref="start1a" index="1"/>
  <ChainPath ref="start1b" index="1"/>
  <ChainPath ref="start2a" index="1"/>
  <ChainPath ref="start2b" index="1"/>
  <ChainPath ref="rsb" index="1"/>
  <ChainPath ref="rsa" index="1"/>
  <text x="137" y="106" font-size="3.65" class="text" text-anchor="middle">{start1a}</text>
  <text x="137" y="111" font-size="3.65" class="text" text-anchor="middle">{start1b}</text>
  <text x="137" y="121" font-size="3.65" class="text" text-anchor="middle">{start2a}</text>
  <text x="137" y="126" font-size="3.65" class="text" text-anchor="middle">{start2b}</text>
  <text x="139.5" y="136" font-size="3.65" class="text" text-anchor="middle">{rsb}</text>
  <text x="139.5" y="141" font-size="3.65" class="text" text-anchor="middle">{rsa}</text>
  <path d="M 165 102 H 201.5 V 147 H 165 Z M 165 117 H 201.5 M 165 132 H 201.5"
        fill="none" stroke="#000000" stroke-width="0.2"/>
  <text x="153" y="110.7" font-size="3.65" class="text" text-anchor="middle">см. лист 5</text>
  <text x="153" y="125.7" font-size="3.65" class="text" text-anchor="middle">см. лист 5</text>
  <ObjView Name="pump1" field="true" x="183.25" y="108.4" font-size="3.65" class="text" text-anchor="middle">Пуск {POS} в режиме «Авт.»</ObjView>
  <ObjView Name="SA1" field="true" related="KM1" x="183.25" y="112.7" font-size="3.65" class="text" text-anchor="middle">К {POS} и {RELATED_POS}</ObjView>
  <ObjView Name="pump2" field="true" x="183.25" y="123.4" font-size="3.65" class="text" text-anchor="middle">Пуск {POS} в режиме «Авт.»</ObjView>
  <ObjView Name="SA2" field="true" related="KM2" x="183.25" y="127.7" font-size="3.65" class="text" text-anchor="middle">К {POS} и {RELATED_POS}</ObjView>
  <text x="183.25" y="138.4" font-size="3.65" class="text" text-anchor="middle">В АСУ ТП верхнего уровня</text>
  <text x="183.25" y="142.7" font-size="3.65" class="text" text-anchor="middle">Modbus RTU</text>
  </g>
 </svg>
</Bl>
