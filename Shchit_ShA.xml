<El Name="Щит автоматизации ЩА">

 <TYPE>щит</TYPE>

<!-- План цепей управления: изображение прибора, как у двигателя М1 — прямоугольник 8 × 3 мм,
     лицевая (верхняя) сторона утолщена на 0,6 мм внутрь прямоугольника. Кабели подходят от стены к середине
     задней стороны (вывод PL (0,1.5)). Начало (0,0) — центр прямоугольника; позиция и номера кабелей — на выноске (блок PL_Vynoska). -->
<svg tip="PL" viewBox="-5 -3 10 6" xmlns="http://www.w3.org/2000/svg">
 <g>
  <rect x="-4" y="-1.5" width="8" height="3" fill="none" stroke="#000000" stroke-width="0.2"/>
  <rect x="-4" y="-1.5" width="8" height="0.6" fill="#000000" stroke="none"/>
 </g>
 <circle cx="0" cy="1.5" r="0" PIN="PL"/>
</svg>

<!-- Схема внешних соединений, по образцу «Щит автоматизации ЩА» на схеме вентиляции Промпроекта
     (Соя, «П3...5,В1,У, откл. вент, внешн.»): прямоугольник высотой 20 мм, надпись 3,5 мм по центру (id="1"),
     кабели подходят к верхней стороне. Ширина 60 мм — на два кабеля с шагом 30 мм: вводы (15,0) и (45,0). -->
<svg tip="SV" viewBox="-2 -2 64 24" xmlns="http://www.w3.org/2000/svg">
 <Bl0 Name="Font"></Bl0>
 <g>
  <polyline points="0,0 60,0 60,20 0,20 0,0" fill="none" stroke="#000000" stroke-width="0.3"/>
  <text id="1" font-size="5.11" x="30" y="11.2" text-anchor="middle" class="text">Щит автоматизации {POS}</text>
 </g>
</svg>

</El>
